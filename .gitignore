# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Настройки с секретами
.env
.env.*
!.env.example
!.env.filled.example

# База данных и рабочие файлы
database/*.db
backups/*.db
logs/*.log*
reports/generated/
data/registry_backup/

# Не игнорировать заглушки пустых папок
!**/.gitkeep

# IDE
.idea/

# Демо-файлы (создаются командой python demo.py)
reports/demo/

# Карта знаний graphify: тяжёлые файлы пересобираются командой /graphify,
# а текстовый отчёт храним в репозитории — по нему ассистент ориентируется
# в новой сессии.
graphify-out/*
!graphify-out/GRAPH_REPORT.md
