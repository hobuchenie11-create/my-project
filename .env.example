# Токен бота — получить у @BotFather в Telegram
BOT_TOKEN=1234567890:AAAA-your-token-here

# Telegram ID администраторов (председатель), через запятую.
# Свой ID можно узнать у бота @userinfobot
ADMIN_IDS=123456789

# Количество жилых квартир в доме
APARTMENTS_COUNT=80

# Количество нежилых помещений
NONRESIDENTIAL_COUNT=2

# ID группового чата дома (необязательно). Если указан, бот будет
# разбирать показания, отправленные прямо в чат.
# Узнать: добавьте бота в чат и отправьте там команду /chatid
GROUP_CHAT_ID=

# ID чата Совета дома. Сюда уходит информационная сводка по задачам
# (кнопка «📤 Сводка для Совета дома»). Это отдельный чат — в чат показаний
# сводка не отправляется. Узнать так же: /chatid в чате Совета.
COUNCIL_CHAT_ID=

# Как бот подтверждает приём показаний в общем чате:
#   auto     — реакция 👍, а если реакции в чате запрещены, короткий ответ
#   reaction — только реакция
#   reply    — всегда коротким сообщением «✅ кв. 5: показания приняты»
#   off      — в чате не подтверждать (квитанция всё равно уйдёт жителю в личку)
CHAT_CONFIRM=auto

# Прокси для подключения к Telegram (необязательно). Нужен, если прямой
# доступ к api.telegram.org закрыт, а работает только через VPN/прокси
# (Nekobox, Hiddify и т.п.). Укажите локальный порт вашего клиента, напр.:
#   PROXY_URL=socks5://127.0.0.1:2080
#   PROXY_URL=http://127.0.0.1:2081
PROXY_URL=

# Период сбора показаний (дни месяца). Показания, переданные позже,
# принимаются с пометкой и учитываются в следующем расчётном периоде.
READINGS_DAY_START=15
READINGS_DAY_END=19

# Дни месяца, когда бот автоматически напоминает должникам (через запятую)
REMINDER_DAYS=15,17,19

# Когда автоматически формировать ведомость непередавших (день месяца и час)
DEBTORS_DAY=20
DEBTORS_HOUR=9

# Когда автоматически формировать ведомость со всеми собранными показаниями.
# До этого часа показания 20 числа ещё попадают в текущий период;
# сразу после — в чат дома уходит сообщение, что сбор завершён.
STATEMENT_DAY=20
STATEMENT_HOUR=14

# Объявление в чат дома о завершении сбора — отдельно от ведомости:
# ведомость уходит председателю в 14:00, а жителям сообщаем вечером.
# Уходит один раз в месяц, перезапуски бота его не повторяют.
ANNOUNCE_DAY=20
ANNOUNCE_HOUR=18

# Реестр ОЭК: бот берёт шаблон ресурсника, проставляет в него показания
# электросчётчиков (лист «Электроэнергия», колонка «Текущие показания — день»),
# убирает листы по горячей и холодной воде и присылает файл председателю.
# Полчаса после ведомости — запас на случай, если сбор шёл дольше обычного.
OEK_DAY=20
OEK_HOUR=14
OEK_MINUTE=30

# Папка с шаблоном от ресурсника. По умолчанию data/oek внутри проекта.
# Файл можно положить туда руками или прислать боту в личку
# (🛠 Меню председателя → 📥 Шаблон ОЭК). Бот берёт самый свежий файл,
# поэтому держите в папке только шаблон — не сваливайте туда ведомости.
OEK_TEMPLATE_DIR=

# Во сколько присылать председателю напоминания по задачам
TASKS_REMINDER_HOUR=9

# Квартиры, которые передают показания ресурсникам напрямую. В печатной
# ведомости их строки скрыты (в реестре остаются — уберите номер отсюда,
# и строка вернётся в ведомость). Через запятую.
SELF_REPORTING_FLATS=2,3
