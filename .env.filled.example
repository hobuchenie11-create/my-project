# =====================================================================
# ОБРАЗЕЦ ЗАПОЛНЕННОГО ФАЙЛА .env  (значения ВЫДУМАННЫЕ, для наглядности)
#
# Это НЕ рабочий файл — бот его не читает. Настоящие настройки нужно
# вписывать в файл .env (без «.filled.example»).
#
# Что делать:
#   1. Скопируйте .env.example -> .env
#   2. В .env замените ТОЛЬКО правую часть после «=» в строках
#      BOT_TOKEN и ADMIN_IDS на свои значения (как показано ниже).
#   3. Сохраните (Ctrl+S) и запустите: python run.py
# =====================================================================

# Токен бота — получить у @BotFather в Telegram
# (единая строка с двоеточием внутри, вставляется целиком, без кавычек)
BOT_TOKEN=8102345678:AAHk9x2mLpQ7vRt3nZwYc1dEfGhIjKlMnOp

# Telegram ID администраторов (председатель), через запятую.
# Свой ID можно узнать у бота @userinfobot. Просто число.
# Несколько председателей: ADMIN_IDS=987654321,555111222
ADMIN_IDS=987654321

# Количество жилых квартир в доме
APARTMENTS_COUNT=80

# Количество нежилых помещений
NONRESIDENTIAL_COUNT=2

# ID группового чата дома (необязательно). Если указан, бот будет
# разбирать показания, отправленные прямо в чат.
GROUP_CHAT_ID=

# Прокси для подключения к Telegram (необязательно). Нужен, если Telegram
# открывается только через VPN/прокси (Nekobox, Hiddify). Укажите локальный
# порт того клиента, через который работает Telegram (у вас — Nekobox):
#   PROXY_URL=socks5://127.0.0.1:2080
PROXY_URL=socks5://127.0.0.1:2080

# Период передачи показаний (дни месяца) — используется в подсказках
READINGS_DAY_START=20
READINGS_DAY_END=25

# Дни месяца, когда бот автоматически напоминает должникам (через запятую)
REMINDER_DAYS=17,23,25
